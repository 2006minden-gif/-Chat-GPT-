Options -Indexes
DirectoryIndex index.php
<Files "favicon.svg">
 ForceType image/svg+xml
</Files>
<Files "favicon.ico">
 ForceType image/x-icon
</Files>
<Files "sitemap.xml">
 ForceType application/xml
</Files>
<Files "robots.txt">
 ForceType text/plain
</Files>
<FilesMatch "^(index|crm)\.html$">
 Require all denied
</FilesMatch>
<FilesMatch "(?i)(^\.|~|\.(bak|bkp|backup|old|orig|save|swp|swo|tmp|sql|ini|log|pem|key|zip|tar|gz)$)">
 Require all denied
</FilesMatch>
RewriteEngine On
RewriteRule ^\.well-known/acme-challenge/[A-Za-z0-9_-]+$ - [END]
RewriteRule ^(?:styles\.css|brand-ui\.css|publications\.css|site\.css|site\.js|portfolio-editor\.js|favicon\.(?:ico|svg)|robots\.txt|sitemap\.xml)$ - [END]
RewriteRule ^ site-router.php [END]
